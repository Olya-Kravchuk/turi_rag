<div class="turi-rag-stepper" data-current-step="{{currentstep}}" data-debug="currentstep={{currentstep}}">

    <div class="mdl-stepper-horizontal-alternative">

        <div class="mdl-stepper-step">

            <div class="mdl-stepper-circle">
                <span>1</span>
            </div>

            <div class="mdl-stepper-title">
                {{#str}}step_start, local_turi_rag{{/str}}
            </div>              

            <div class="mdl-stepper-bar-left"></div>
            <div class="mdl-stepper-bar-right"></div>

        </div>


        <div class="mdl-stepper-step">

            <div class="mdl-stepper-circle">
                <span>2</span>
            </div>

            <div class="mdl-stepper-title">
                {{#str}}documents_selected, local_turi_rag{{/str}}
            </div>

            <div class="mdl-stepper-bar-left"></div>
            <div class="mdl-stepper-bar-right"></div>

        </div>


        <div class="mdl-stepper-step">

            <div class="mdl-stepper-circle">
                <span>3</span>
            </div>

            <div class="mdl-stepper-title">
                {{#str}}rag_profile_preparing_documents, local_turi_rag{{/str}}
            </div>


            <div class="mdl-stepper-bar-left"></div>
            <div class="mdl-stepper-bar-right"></div>

        </div>


        <div class="mdl-stepper-step">

            <div class="mdl-stepper-circle">
                <span>4</span>
            </div>

            <div class="mdl-stepper-title">
                {{#str}}system_prompt, local_turi_rag{{/str}}
            </div>

            <div class="mdl-stepper-bar-left"></div>
            <div class="mdl-stepper-bar-right"></div>

        </div>


        <div class="mdl-stepper-step">

            <div class="mdl-stepper-circle">
                <span>5</span>
            </div>

            <div class="mdl-stepper-title">
                {{#str}}completed, local_turi_rag{{/str}}
            </div>

            <div class="mdl-stepper-bar-left"></div>
            <div class="mdl-stepper-bar-right"></div>

        </div>

    </div>

</div>
