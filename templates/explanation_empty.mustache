<div class="turi-rag-wrapper">
    <div class="turi-rag-profile">
        <h2 class="turi-rag-title">
            {{#str}}explanation, local_turi_rag{{/str}}
        </h2>

        <p class="turi-rag-description">
            {{#str}}no_rag_profile_description, local_turi_rag{{/str}}
        </p>

        <p class="turi-rag-description">
            {{#str}}rag_profile_step_by_step, local_turi_rag{{/str}}
        </p>

        <p class="turi-rag-description">
            {{#str}}more_information, local_turi_rag{{/str}}
        </p>

        <div>
            <a
                href="{{starturl}}"
                class="turi-rag-button turi-rag-button-secondary">
                {{#str}}start, local_turi_rag{{/str}}
            </a>
        </div>
    </div>
</div>
