<div class="turi-rag-wrapper">
    <div class="turi-rag-profile">

        <form method="post" action="{{finishurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">

            <div class="turi-rag-section-header">
                <h2 class="turi-rag-title">
                    {{#str}}prompt_settings, local_turi_rag{{/str}}
                </h2>
            </div>

            <div class="turi-rag-prompt-block-setting">

                <p class="turi-rag-subtitle">
                    {{#str}}prompt_block_description, local_turi_rag{{/str}}
                </p>
                
                <label>

                    <input
                        class="turi-rag-checkbox"
                        type="checkbox"
                        name="promptblock_enabled"
                        value="1"
                        {{#promptblock_enabled}}checked{{/promptblock_enabled}}>

                    <span class="turi-rag-checkbox-label">
                        {{#str}}enable_prompt_block, local_turi_rag{{/str}}
                    </span>

                </label>

                <p class="turi-rag-subtitle">
                    {{#str}}choose_system_prompt, local_turi_rag{{/str}}
                </p>

            </div>

            <div class="turi-rag-prompt-list">

                {{#systemprompts}}

                    {{#system_prompt}}

                    <label class="turi-rag-prompt-card">

                        <input
                            class="turi-rag-checkbox"
                            type="radio"
                            name="systemprompt"
                            value="{{id}}"
                            {{#selected}}checked{{/selected}}>

                        <div class="turi-rag-prompt-card-content">

                            <div class="turi-rag-prompt-card-header">

                                <span class="turi-rag-prompt-name">
                                    {{name}}
                                </span>

                                <span class="turi-rag-prompt-temperature">
                                    {{#str}}temperature, local_turi_rag{{/str}}: {{temp_min}} - {{temp_max}}
                                </span>

                            </div>

                            <p class="turi-rag-description">
                                {{description}}
                            </p>

                        </div>

                    </label>

                    {{/system_prompt}}

                {{/systemprompts}}

            </div>

            <div class="turi-rag-system-prompt-actions">

                <button
                    type="submit"
                    class="turi-rag-button turi-rag-button-secondary">
                    {{#str}}save, local_turi_rag{{/str}}
                </button>

            </div>

        </form>

    </div>
</div>
