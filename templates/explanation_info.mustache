<div class="turi-rag-wrapper">
    <div class="turi-rag-profile">

        <h2 class="turi-rag-title">
            {{#str}}explanation, local_turi_rag{{/str}}
        </h2>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}what_is_rag_profile, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}what_is_rag_profile_desc, local_turi_rag{{/str}}
            </p>
        </div>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}create_rag_profile, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}create_rag_profile_desc, local_turi_rag{{/str}}
            </p>
        </div>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}activate_ai_assistant, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}activate_ai_assistant_desc, local_turi_rag{{/str}}
            </p>
        </div>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}select_upload_documents, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}select_upload_documents_desc, local_turi_rag{{/str}}
            </p>
        </div>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}course_assignment, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}course_assignment_desc, local_turi_rag{{/str}}
            </p>
        </div>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}select_system_prompt, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}select_system_prompt_desc, local_turi_rag{{/str}}
            </p>
        </div>

        <div class="turi-rag-info-block">
            <h3 class="turi-rag-subtitle">
                {{#str}}delete_rag_profile, local_turi_rag{{/str}}
            </h3>

            <p class="turi-rag-description">
                {{#str}}delete_rag_profile_desc, local_turi_rag{{/str}}
            </p>

            <p class="turi-rag-note">
                <strong>{{#str}}note, local_turi_rag{{/str}}</strong>
                {{#str}}delete_rag_profile_note, local_turi_rag{{/str}}
            </p>
        </div>

    </div>
</div>
