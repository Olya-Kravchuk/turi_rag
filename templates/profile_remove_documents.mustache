<div class="turi-rag-wrapper">
    <div class="turi-rag-profile">

        <div class="turi-rag-profile-header">
            <div class="turi-rag-profile-info">
                <h2 class="turi-rag-title">
                    {{#str}}remove_documents, local_turi_rag{{/str}}
                </h2>
                <p class="turi-rag-description">
                    {{#str}}remove_documents_description, local_turi_rag{{/str}}
                </p>
            </div>
        </div>

        <form method="post" action="{{actionurl}}">

            <input
                type="hidden"
                name="sesskey"
                value="{{sesskey}}"
            >

            <div class="turi-rag-profile-documents">
                {{> local_turi_rag/document_table}}

                <div class="turi-rag-profile-actions">
                    <a
                        href="{{cancelurl}}"
                        class="turi-rag-button turi-rag-button-primary">
                        {{#str}}cancel, local_turi_rag{{/str}}
                    </a>

                    <button
                        type="submit"
                        class="turi-rag-button turi-rag-button-secondary">
                        {{#str}}delete, local_turi_rag{{/str}}
                    </button>
                </div>
            </div>

        </form>

    </div>
</div>